          <text>gender</text>
        </inputExpression>
      </input>
      <input id="InputClause_0xwhlqm" label="Age">
        <inputExpression id="LiteralExpression_1jp2ehq" typeRef="integer">
          <text>age</text>
        </inputExpression>
      </input>
      <input id="InputClause_1do2npn" label="Intervention Count">
        <inputExpression id="LiteralExpression_03l8anu" typeRef="integer">
          <text>timesInterventionUsed</text>
        </inputExpression>
      </input>
      <input id="InputClause_0tpmtph" label="Individual limit" biodi:width="192">
        <inputExpression id="LiteralExpression_1xi6jg8" typeRef="long">
          <text>claimAmount</text>
        </inputExpression>
      </input>
      <output id="decisionOutput" name="isAutoApproved" typeRef="boolean" />
      <rule id="rule1">
        <inputEntry id="categoryEntry1">
          <text>"Ambulance and Emergency Services"</text>
        </inputEntry>
        <inputEntry id="serviceCategoryEntry1">
          <text>"Outpatient"</text>
