<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_192tvnm" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:process id="civilPreAuthProcess" name="Civil PreAuth Approval processv1" isExecutable="true">
    <bpmn:sequenceFlow id="Flow_start_to_preauth" sourceRef="StartEvent_1" targetRef="PreAuthorizationInit" />
    <bpmn:sequenceFlow id="Flow_0s0a7de" sourceRef="PreAuthorizationInit" targetRef="Activity_preauth_postSaveValidation" />
    <bpmn:serviceTask id="Activity_preauth_postSaveValidation" name="Post-Save Validation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="postSaveValidationHandler" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0s0a7de</bpmn:incoming>
      <bpmn:outgoing>Flow_preauth_postSaveToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_preauth_postSaveValidation" name="Post-Save Validation Passed?">
      <bpmn:incoming>Flow_preauth_postSaveToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_preauth_postSavePass</bpmn:outgoing>
      <bpmn:outgoing>Flow_preauth_postSaveFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_preauth_postSaveToGateway" sourceRef="Activity_preauth_postSaveValidation" targetRef="Gateway_preauth_postSaveValidation" />
    <bpmn:sequenceFlow id="Flow_preauth_postSavePass" name="Passed" sourceRef="Gateway_preauth_postSaveValidation" targetRef="Activity_0qv99bj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isPostSaveValidationFailed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_preauth_postSaveFail" name="Failed" sourceRef="Gateway_preauth_postSaveValidation" targetRef="Activity_042boft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isPostSaveValidationFailed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_180tmra" sourceRef="Activity_0qv99bj" targetRef="Gateway_1p5r2u0" />
    <bpmn:sequenceFlow id="Flow_13sw83s" sourceRef="Gateway_1p5r2u0" targetRef="Gateway_0lzx0hk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isCivilServantClaim = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1oipcih" name="Civil Servant PreAuth" sourceRef="Gateway_1p5r2u0" targetRef="Activity_1xl0hds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isCivilServantClaim = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ugkj0d" sourceRef="Activity_1xl0hds" targetRef="Gateway_0lzx0hk" />
    <bpmn:sequenceFlow id="Flow_approve_to_doctor" name="Approve" sourceRef="Gateway_0lzx0hk" targetRef="Activity_1wqn2at">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isAutoApproved = true and isCivilServiceApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ewiz50" name="Rejected" sourceRef="Gateway_0lzx0hk" targetRef="Activity_1yl2ye8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isAutoApproved = false or isCivilServiceApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_doctor_to_efwa" sourceRef="Activity_1wqn2at" targetRef="Activity_checkEfwa" />
    <bpmn:sequenceFlow id="Flow_efwa_to_gateway" sourceRef="Activity_checkEfwa" targetRef="Gateway_1vc3zh6" />
    <bpmn:sequenceFlow id="Flow_efwa_false" sourceRef="Gateway_1vc3zh6" targetRef="Gateway_0749b15" />
    <bpmn:sequenceFlow id="Flow_1mhgq5v" sourceRef="Gateway_1vc3zh6" targetRef="Activity_0engolr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isEfwaEnabled = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17e3lwl" sourceRef="Activity_0engolr" targetRef="Activity_14iyyc2" />
    <bpmn:sequenceFlow id="Flow_153xyau" sourceRef="Activity_14iyyc2" targetRef="Gateway_0vblj95" />
    <bpmn:sequenceFlow id="Flow_ai_sent_back" name="AI Sent Back" sourceRef="Gateway_0vblj95" targetRef="Activity_042boft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=aiDecision = "SENT_BACK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ai_to_normal" name="AI to Normal Flow" sourceRef="Gateway_0vblj95" targetRef="Gateway_0749b15" />
    <bpmn:sequenceFlow id="Flow_1n3jfjd" sourceRef="Gateway_0749b15" targetRef="Activity_0mzo0j2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isDoctorApprovalRequired=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_nodoc_to_override" sourceRef="Gateway_0749b15" targetRef="Activity_1cve9uj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isDoctorApprovalRequired=false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0r8nnwv" sourceRef="Activity_0mzo0j2" targetRef="Gateway_02qowes" />
    <bpmn:sequenceFlow id="Flow_doc_approved_to_override" name="Approved by doctor" sourceRef="Gateway_02qowes" targetRef="Activity_1cve9uj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApprovedByDoc = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1coluhq" name="Rejected by doctor" sourceRef="Gateway_02qowes" targetRef="Activity_1yl2ye8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApprovedByDoc = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1b54pkl" sourceRef="Activity_1cve9uj" targetRef="Event_0d1m7um" />
    <bpmn:sequenceFlow id="Flow_0mtsyqu" sourceRef="Activity_1yl2ye8" targetRef="Activity_042boft" />
    <bpmn:sequenceFlow id="Flow_1m6phn9" sourceRef="Activity_042boft" targetRef="Event_1as1l6j" />
    <bpmn:sequenceFlow id="Flow_1q9xzbt" sourceRef="Event_1as1l6j" targetRef="PreAuthorizationInit" />
    <bpmn:startEvent id="StartEvent_1" name="Payment requested">
      <bpmn:outgoing>Flow_start_to_preauth</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PreAuthorizationInit" name="Process PreAuthorization Data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="preAuthHandler" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_preauth</bpmn:incoming>
      <bpmn:incoming>Flow_1q9xzbt</bpmn:incoming>
      <bpmn:outgoing>Flow_0s0a7de</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0qv99bj" name="AutoApproval">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=isAutoApproved=true" target="isAutoApproved" />
          <zeebe:output source="=isCivilServiceApproved = true" target="isCivilServiceApproved" />
        </zeebe:ioMapping>
        <zeebe:taskDefinition type="autoAdjudicationHandler" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_preauth_postSavePass</bpmn:incoming>
      <bpmn:outgoing>Flow_180tmra</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1p5r2u0">
      <bpmn:incoming>Flow_180tmra</bpmn:incoming>
      <bpmn:outgoing>Flow_13sw83s</bpmn:outgoing>
      <bpmn:outgoing>Flow_1oipcih</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1xl0hds" name="Civil Pre Auth Verify">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="preAuthCivilHandler" retries="2" />
        <zeebe:ioMapping>
          <zeebe:output source="=isCivilServiceApproved&#10;= true" target="isCivilServiceApproved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1oipcih</bpmn:incoming>
      <bpmn:outgoing>Flow_0ugkj0d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0lzx0hk" name="Claim Status">
      <bpmn:incoming>Flow_13sw83s</bpmn:incoming>
      <bpmn:incoming>Flow_0ugkj0d</bpmn:incoming>
      <bpmn:outgoing>Flow_1ewiz50</bpmn:outgoing>
      <bpmn:outgoing>Flow_approve_to_doctor</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1wqn2at" name="Doctor Approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="doctorApprovalHandler" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_approve_to_doctor</bpmn:incoming>
      <bpmn:outgoing>Flow_doctor_to_efwa</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_checkEfwa" name="Check EFWA Eligibility">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="checkEfwaEligibilityHandler" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_doctor_to_efwa</bpmn:incoming>
      <bpmn:outgoing>Flow_efwa_to_gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1vc3zh6" default="Flow_efwa_false">
      <bpmn:incoming>Flow_efwa_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_efwa_false</bpmn:outgoing>
      <bpmn:outgoing>Flow_1mhgq5v</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_0engolr" name="AI Request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="sendPreAuthEfwaRequest" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1mhgq5v</bpmn:incoming>
      <bpmn:outgoing>Flow_17e3lwl</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_14iyyc2" name="Waiting AI Notes Confirmation" messageRef="Message_AiNotesConfirmation">
      <bpmn:incoming>Flow_17e3lwl</bpmn:incoming>
      <bpmn:outgoing>Flow_153xyau</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_0vblj95" default="Flow_ai_to_normal">
      <bpmn:incoming>Flow_153xyau</bpmn:incoming>
      <bpmn:outgoing>Flow_ai_sent_back</bpmn:outgoing>
      <bpmn:outgoing>Flow_ai_to_normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_0749b15">
      <bpmn:incoming>Flow_efwa_false</bpmn:incoming>
      <bpmn:incoming>Flow_ai_to_normal</bpmn:incoming>
      <bpmn:outgoing>Flow_1n3jfjd</bpmn:outgoing>
      <bpmn:outgoing>Flow_nodoc_to_override</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_0mzo0j2" name="Review by Doctor">
      <bpmn:extensionElements>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="start" type="preAuthAssignedToDocStartEvent" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n3jfjd</bpmn:incoming>
      <bpmn:outgoing>Flow_0r8nnwv</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_02qowes">
      <bpmn:incoming>Flow_0r8nnwv</bpmn:incoming>
      <bpmn:outgoing>Flow_doc_approved_to_override</bpmn:outgoing>
      <bpmn:outgoing>Flow_1coluhq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1cve9uj" name="PreAuth Completion">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handlePreAuthApprovedEvent" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_nodoc_to_override</bpmn:incoming>
      <bpmn:incoming>Flow_doc_approved_to_override</bpmn:incoming>
      <bpmn:outgoing>Flow_1b54pkl</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0d1m7um">
      <bpmn:incoming>Flow_1b54pkl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_1yl2ye8" name="Mark Auth as Rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handleClaimAutoAdjFail" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ewiz50</bpmn:incoming>
      <bpmn:incoming>Flow_1coluhq</bpmn:incoming>
      <bpmn:outgoing>Flow_0mtsyqu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_042boft" name="Return back to Provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handlePreAuthReturnedEvent" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mtsyqu</bpmn:incoming>
      <bpmn:incoming>Flow_ai_sent_back</bpmn:incoming>
      <bpmn:incoming>Flow_preauth_postSaveFail</bpmn:incoming>
      <bpmn:outgoing>Flow_1m6phn9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_1as1l6j" name="Return to Sender">
      <bpmn:incoming>Flow_1m6phn9</bpmn:incoming>
      <bpmn:outgoing>Flow_1q9xzbt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_05ww9im" messageRef="Message_3dttrre" />
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmn:error id="Error_04fwyr5" name="Invalid expiry date error" errorCode="creditCardError" />
  <bpmn:message id="Message_34pv5cc" name="Message_34pv5cc" />
  <bpmn:message id="Message_3mml6qq" name="paymentStatusMsg">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=paymentStatus" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:signal id="Signal_12upvvs" name="markFor" />
  <bpmn:message id="Message_3dttrre" name="preAuthResubmit">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=claimId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_AiNotesConfirmation" name="receiveEfwaNotes">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=claimId" />
    </bpmn:extensionElements>
  </bpmn:message>
